#!/usr/bin/env perl

use strict;
use warnings;

=head1 NAME

postfilter - INN filter_nnrpd.pl entry point for Postfilter-NG.

=head1 INSTALLATION

Rc6 installs this entry point inside an immutable versioned release directory.
The installer generates regular C<filter_nnrpd.pl.ng> and C<filter_nnrpd.pl>
wrapper files that add the selected release library directory and load this file
through Perl C<do>. The candidate wrapper is activated explicitly and is never a
link to a mutable base prefix. INN loads the active wrapper once for each nnrpd
process.  The engine is constructed on
first use and reused for all POST commands in that client session.  C<filter_end>
is an official nnrpd Perl-hook callback and closes the SQLite connection before
INN unloads the filter.

=cut

use Cwd ();
use File::Basename ();

BEGIN {
    # INN loads filter_nnrpd.pl through its embedded Perl interpreter.  In that
    # environment $0 identifies nnrpd, not this file, so FindBin cannot locate
    # the installed module tree. __FILE__ identifies this release-local entry
    # point whether it was loaded directly or through an rc6 wrapper.
    my $entry_point = Cwd::abs_path(__FILE__) // __FILE__;
    my $project_root = File::Basename::dirname($entry_point);
    unshift @INC, "$project_root/lib";
}

use Postfilter::InstallPaths;
use Postfilter::NG;

our (%hdr, %attributes, $body, $user, $modify_headers);

my $engine;

# Function: _engine
# Purpose: Lazily constructs one Postfilter-NG engine for the lifetime of the current nnrpd
#          process.
# Parameters: No positional parameters, or arguments are read directly by the command wrapper.
# Operational notes: Failure behaviour is explicit in the function body and follows the caller’s
#                    configured fail-open/fail-closed policy.
sub _engine {
    return $engine if $engine;

    $engine = Postfilter::NG->new(
        config    => Postfilter::InstallPaths::config_file(),
        state_dir => Postfilter::InstallPaths::state_dir(),
    );

    return $engine;
}

# Function: filter_post
# Purpose: INN hook entry point that passes one POST to the reusable Postfilter-NG engine.
# Parameters: No positional parameters, or arguments are read directly by the command wrapper.
# Operational notes: Failure behaviour is explicit in the function body and follows the caller’s
#                    configured fail-open/fail-closed policy.
sub filter_post {
    # Tell INN that changes made to %hdr should be written back to the article.
    $modify_headers = 1;

    return _engine()->process_article(
        attributes => \%attributes,
        body       => $body // '',
        headers    => \%hdr,
        user       => $user // '',
    );
}

# Function: filter_end
# Purpose: INN hook shutdown callback that releases the per-nnrpd engine and database handle.
# Parameters: No positional parameters, or arguments are read directly by the command wrapper.
# Operational notes: Failure behaviour is explicit in the function body and follows the caller’s
#                    configured fail-open/fail-closed policy.
sub filter_end {
    $engine->shutdown if $engine;
    undef $engine;
    return '';
}

1;
