# Function: _install_configuration_files
# Purpose: Installs main/fragments/assets while preserving operator files on upgrade.
# Parameters: No positional parameters, or arguments are read directly by the command wrapper.
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _install_configuration_files {
    my $main_installed = _install_config_file(
        "$source_root/conf/postfilter.toml",
        "$option{config_dir}/postfilter.toml",
    );

    for my $source (glob("$source_root/conf/conf.d/*.toml")) {
        my ($name) = $source =~ m{/([^/]+)$};
        _install_config_file(
            $source,
            "$option{config_dir}/conf.d/$name",
        );
    }

    for my $name (qw(custom.pm custom.pm.example README.md)) {
        next unless -f "$source_root/conf/$name";
        _install_config_file(
            "$source_root/conf/$name",
            "$option{config_dir}/$name",
        );
    }

    _install_config_file(
        "$source_root/share/public_suffix_list.dat",
        "$option{config_dir}/public_suffix_list.dat",
    );

    if (-f "$source_root/share/static/report.css") {
        _install_config_file(
            "$source_root/share/static/report.css",
            "$option{config_dir}/report.css",
        );
    }

    return $main_installed;
}

# Function: _install_config_file
# Purpose: Copies one configuration asset only when policy permits replacement.
# Parameters: $source, $destination
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _install_config_file {
    my ($source, $destination) = @_;

    if (-e $destination && !$option{force_config}) {
        print "Preserving existing configuration $destination\n";
        return 0;
    }

    copy($source, $destination)
        or die "Unable to copy $source to $destination: $!";
    chmod 0640, $destination;
    return 1;
}

# Function: _replace_default_paths
# Purpose: Rewrites shipped path defaults to detected or explicitly supplied installation paths.
# Parameters: $path
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _replace_default_paths {
    my ($path) = @_;

    open my $input, '<:raw', $path or die "Unable to read $path: $!";
    local $/;
    my $text = <$input>;
    close $input or die "Unable to close $path: $!";

    for my $pair (@{ _legacy_path_replacements() }) {
        my ($old, $replacement) = @{$pair};
        $text =~ s{\Q$old\E(?=/|["']|\z)}{$replacement}g;
    }

    my $temporary = "$path.tmp.$$";
    open my $output, '>:raw', $temporary
        or die "Unable to create $temporary: $!";
    print {$output} $text
        or die "Unable to write $temporary: $!";
    close $output
        or die "Unable to close $temporary: $!";
    chmod 0640, $temporary
        or die "Unable to chmod $temporary: $!";
    rename $temporary, $path
        or die "Unable to activate rewritten configuration $path: $!";
    return;
}

# Function: _legacy_path_replacements
# Purpose: Returns exact historical shipped defaults and their detected site-local replacements.
# Parameters: None.
# Operational notes: Long paths are listed first and replacement requires a path boundary.
sub _legacy_path_replacements {
    return [
        ['/var/spool/news/postfilter-ng/rejected', $option{saved_dir}],
        ['/var/lib/news/postfilter-ng',           $option{state_dir}],
        ['/var/www/html/postfilter',              $option{html_dir}],
        ['/var/lib/news/active',                  $option{active_file}],
        ['/usr/lib/news/bin/innmail',             $option{sendmail}],
        ['/etc/news/postfilter-ng',               $option{config_dir}],
    ];
}

# Function: _migrate_existing_configuration_paths
# Purpose: Migrates only historical shipped path defaults in preserved operator TOML files.
# Parameters: None.
# Operational notes: Every changed file is backed up before replacement; custom paths remain intact.
sub _migrate_existing_configuration_paths {
    my @files = (
        "$option{config_dir}/postfilter.toml",
        sort glob("$option{config_dir}/conf.d/*.toml"),
    );
    my $backup_root = "$option{config_dir}/upgrade-backups/"
        . _timestamp_compact() . "-$$";

    my $result = migrate_legacy_path_files(
        files        => \@files,
        replacements => _legacy_path_replacements(),
        config_root  => $option{config_dir},
        backup_root  => $backup_root,
        log          => sub {
            my ($path, $backup, $count) = @_;
            print "Migrated $count historical path value(s) in $path\n";
            print "  backup: $backup\n";
        },
    );

    if ($result->{replacement_count}) {
        print "Migrated $result->{replacement_count} historical path value(s) "
            . "across " . scalar(@{ $result->{changed_files} }) . " configuration file(s).\n";
        print "Upgrade backup directory: $result->{backup_root}\n";
    }
    else {
        print "No historical default paths required migration.\n";
    }

    return;
}

# Function: _install_distribution_configuration_snapshots
# Purpose: Installs current path-adjusted TOML examples beside preserved operator files as .dist.
# Parameters: None.
# Operational notes: .dist files are not loaded by Postfilter-NG and are safe for manual comparison.
sub _install_distribution_configuration_snapshots {
