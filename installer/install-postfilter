# Function: _rewrite_installed_shebangs
# Purpose: Replaces portable source-tree shebangs with the absolute active Perl interpreter.
# Parameters: $directory, $interpreter
# Operational notes: The repository remains executable through /usr/bin/env; installed commands
#                    do not depend on PATH or on a distribution-specific Perl location.
sub _rewrite_installed_shebangs {
    my ($directory, $interpreter) = @_;

    for my $relative (qw(
        postfilter
        bin/postfilterctl
        installer/install-postfilter
        Makefile.PL
    )) {
        my $path = "$directory/$relative";
        next unless -f $path;

        open my $input, '<:raw', $path
            or die "Unable to read $path while rewriting shebang: $!";
        local $/;
        my $text = <$input>;
        close $input;

        $text =~ s{\A\#![^\r\n]*perl[^\r\n]*(?:\r?\n)}{#!$interpreter\n}
            or die "No Perl shebang found in $path\n";

        my $mode = 0755;
        open my $output, '>:raw', $path
            or die "Unable to write $path while rewriting shebang: $!";
        print {$output} $text
            or die "Unable to update shebang in $path: $!";
        close $output
            or die "Unable to close $path after rewriting shebang: $!";
        chmod $mode, $path
            or die "Unable to restore mode on $path: $!";
    }

    return;
}

# Function: _write_install_paths_module
# Purpose: Persists installer-detected runtime defaults inside the activated code prefix.
# Parameters: $path
# Operational notes: Environment variables can still override these values for one-shot tests.
sub _write_install_paths_module {
    my ($path) = @_;

    my $config_file = _perl_single_quoted(
        "$option{config_dir}/postfilter.toml",
    );
    my $state_directory = _perl_single_quoted($option{state_dir});

    my $contents = <<"MODULE";
package Postfilter::InstallPaths;

use strict;
use warnings;

our \$VERSION = '2026.07.5-rc7';

use constant CONFIG_FILE => $config_file;
use constant STATE_DIR   => $state_directory;

sub config_file {
    return \$ENV{POSTFILTER_CONFIG} // CONFIG_FILE;
}

sub state_dir {
    return \$ENV{POSTFILTER_STATE_DIR} // STATE_DIR;
}

1;
MODULE

    my $temporary = "$path.tmp.$$";
    open my $handle, '>:raw', $temporary
        or die "Unable to create $temporary: $!";
    print {$handle} $contents
        or die "Unable to write $temporary: $!";
    close $handle
        or die "Unable to close $temporary: $!";
    chmod 0644, $temporary
        or die "Unable to chmod $temporary: $!";
    rename $temporary, $path
        or die "Unable to activate generated path module $path: $!";

    my $library_root = dirname(dirname($path));
    _system_with_clean_perl_environment(
        $perl_path, "-I$library_root", '-c', $path,
    ) == 0
        or die "Generated runtime path module does not compile: $path\n";

    return;
}

# Function: _perl_single_quoted
# Purpose: Quotes one installer path as a safe single-quoted Perl literal.
# Parameters: $value
# Operational notes: Newlines and carriage returns are rejected before code generation.
sub _perl_single_quoted {
    my ($value) = @_;
    die "Unsafe newline in installation path\n"
        if !defined($value) || $value =~ /[\r\n]/;

    $value =~ s/\\/\\\\/g;
    $value =~ s/'/\\'/g;
    return "'$value'";
}

