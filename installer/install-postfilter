# Function: _configured_saved_subdirectories
# Purpose: Resolves and validates the text and binary diagnostic directory names.
# Parameters: $configuration_path
# Operational notes: Only one safe path component is accepted for each world; a
#                    value capable of escaping saved_dir aborts installation.
sub _configured_saved_subdirectories {
    my ($configuration_path) = @_;

    my $configuration = _load_installer_configuration($configuration_path);
    my %subdirectory;

    for my $article_type (qw(text binary)) {
        my $value =
            $configuration->{article_types}{$article_type}{save_rejected}{subdirectory}
            // $article_type;

        die "Unsafe saved-article subdirectory for $article_type: $value\n"
            unless !ref($value)
            && $value =~ /\A[A-Za-z0-9_.-]+\z/
            && $value ne '.'
            && $value ne '..';

        $subdirectory{$article_type} = $value;
    }

    return \%subdirectory;
}

# Function: _load_installer_configuration
# Purpose: Loads main TOML plus sorted fragments for installer path/key decisions.
# Parameters: $configuration_path
# Operational notes: This parser is used only after dependency checks and before
#                    activation validation; malformed TOML aborts the install phase.
sub _load_installer_configuration {
    my ($configuration_path) = @_;

    require TOML::Tiny;

    my @configuration_files = ($configuration_path);
    my $fragment_directory = dirname($configuration_path) . '/conf.d';
    if (-d $fragment_directory) {
        push @configuration_files,
            sort glob("$fragment_directory/*.toml");
    }

    my $configuration = {};
    for my $path (@configuration_files) {
        open my $handle, '<:raw', $path
            or die "Unable to read $path: $!";
        local $/;
        my $text = <$handle>;
        close $handle;

        my $fragment = TOML::Tiny::from_toml($text);
        die "Unable to parse installer configuration in $path"
            unless ref($fragment) eq 'HASH';
        _merge_configuration_hash($configuration, $fragment);
    }

    return $configuration;
}

# Function: _merge_configuration_hash
# Purpose: Recursively merges installer-only configuration tables used to resolve key paths.
# Parameters: $destination, $source
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _merge_configuration_hash {
    my ($destination, $source) = @_;

    for my $key (keys %{$source}) {
        if (
            ref($source->{$key}) eq 'HASH'
            && ref($destination->{$key}) eq 'HASH'
        ) {
            _merge_configuration_hash(
                $destination->{$key},
                $source->{$key},
            );
            next;
        }

        $destination->{$key} = $source->{$key};
    }

    return $destination;
}

=head2 _create_random_key($path, $purpose)

Creates exactly 64 bytes from /dev/urandom.  O_EXCL makes concurrent installers
safe and guarantees that an existing key is never silently replaced.

=cut

# Function: _create_random_key
# Purpose: Creates and verifies one non-overwritten 64-byte key from /dev/urandom.
# Parameters: $path, $purpose
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _create_random_key {
    my ($path, $purpose) = @_;

    if (-f $path) {
        my $size = -s $path;
        die "Existing key $path for $purpose is shorter than 32 bytes\n"
            if !defined($size) || $size < 32;
        print "Preserving existing key $path ($purpose)\n";
        return;
    }

    make_path(dirname($path), { mode => 0750 }) unless -d dirname($path);

    sysopen(
        my $key_handle,
        $path,
        O_WRONLY | O_CREAT | O_EXCL,
        0640,
    ) or die "Unable to create key $path: $!";
    binmode $key_handle;

    open my $random, '<:raw', '/dev/urandom'
        or die "Unable to open /dev/urandom: $!";

    my $key_material = '';
    while (length($key_material) < 64) {
        my $read = read(
            $random,
            my $chunk,
            64 - length($key_material),
        );
        die "Unable to read /dev/urandom: $!" unless defined $read;
        die "/dev/urandom returned EOF" if $read == 0;
        $key_material .= $chunk;
    }

    close $random or die "Unable to close /dev/urandom: $!";
    print {$key_handle} $key_material
        or die "Unable to write key $path: $!";
    close $key_handle
        or die "Unable to close key $path: $!";

    print "Created key $path ($purpose) from /dev/urandom\n";
    return;
}

=head2 Activation and ownership

=cut

# Function: _set_configuration_ownership
# Purpose: Recursively applies root:news-style ownership and non-writable configuration
#          permissions.
# Parameters: $directory, $group
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _set_configuration_ownership {
    my ($directory, $group) = @_;

    my $group_id = getgrnam($group);
    die "Unknown group $group\n" unless defined $group_id;

    chown 0, $group_id, $directory;
    chmod 0750, $directory;

    opendir my $handle, $directory
        or die "Unable to open $directory: $!";
    for my $name (readdir $handle) {
        next if $name eq '.' || $name eq '..';
        my $path = "$directory/$name";

        if (-d $path) {
            _set_configuration_ownership($path, $group);
        }
        else {
            chown 0, $group_id, $path;
            chmod 0640, $path;
        }
    }
    closedir $handle;
    return;
}

# Function: _chown_tree
# Purpose: Recursively assigns runtime ownership and documented directory/file modes.
# Parameters: $directory, $user, $group, $directory_mode, $file_mode
# Operational notes: Runtime state and saved articles are writable by the INN account; HTML
#                    output may use a separate world-readable mode supplied by the caller.
sub _chown_tree {
    my ($directory, $user, $group, $directory_mode, $file_mode) = @_;

    my $user_id = getpwnam($user);
    my $group_id = getgrnam($group);
    die "Unknown user $user\n" unless defined $user_id;
    die "Unknown group $group\n" unless defined $group_id;

    $directory_mode //= 0750;
    $file_mode //= 0640;

    chown $user_id, $group_id, $directory
        or die "Unable to chown $directory to $user:$group: $!";
    chmod $directory_mode, $directory
        or die "Unable to chmod $directory: $!";

    opendir my $handle, $directory
        or die "Unable to open $directory: $!";
    for my $name (readdir $handle) {
        next if $name eq '.' || $name eq '..';
        my $path = "$directory/$name";

        if (-d $path) {
            _chown_tree(
                $path, $user, $group, $directory_mode, $file_mode,
            );
            next;
        }

        chown $user_id, $group_id, $path
            or die "Unable to chown $path to $user:$group: $!";
        chmod $file_mode, $path
            or die "Unable to chmod $path: $!";
    }
    closedir $handle;
    return;
}

# Function: _clear_perl_environment
# Purpose: Removes inherited Perl library and build variables before installer verification.
# Parameters: None.
# Operational notes: This prevents an older site-local module from shadowing the activated prefix.
sub _clear_perl_environment {
    delete @ENV{qw(
        PERL5LIB PERLLIB PERL5OPT PERL_LOCAL_LIB_ROOT PERL_MB_OPT PERL_MM_OPT
        POSTFILTER_CONFIG POSTFILTER_STATE_DIR
    )};
    return;
}

# Function: _system_with_clean_perl_environment
# Purpose: Executes one command after locally removing inherited Perl path and option variables.
# Parameters: @command
# Operational notes: The parent environment is restored automatically after system returns.
sub _system_with_clean_perl_environment {
    my (@command) = @_;
    local %ENV = %ENV;
    _clear_perl_environment();
    return system { $command[0] } @command;
}

# Function: _timestamp_compact
# Purpose: Returns one UTC timestamp safe for backup and failed-install directory names.
# Parameters: None.
# Operational notes: PID suffixes supplied by callers make same-second names unique.
sub _timestamp_compact {
    return POSIX::strftime('%Y%m%dT%H%M%SZ', gmtime());
}

# Function: _run_as_runtime_user
# Purpose: Executes one installer validation command with the configured INN uid and gid.
# Parameters: @command
# Operational notes: The child drops real/effective uid and gid before exec so configuration
#                    snapshots and SQLite files are created by the same account used by nnrpd.
sub _run_as_runtime_user {
    my (@command) = @_;

    my @account = getpwnam($option{user});
    die "Unknown user $option{user}\n" unless @account;
    my ($user_id, $account_group_id, $home) = @account[2, 3, 7];
    my $group_id = getgrnam($option{group});
    die "Unknown group $option{group}\n" unless defined $group_id;

    my $pid = fork();
    die "Unable to fork installer validation command: $!\n"
        unless defined $pid;

    if ($pid == 0) {
        $ENV{HOME} = $home if defined $home && length $home;
        $ENV{USER} = $option{user};
        $ENV{LOGNAME} = $option{user};
        _clear_perl_environment();

        # Clear inherited root-only supplementary groups, then drop real,
        # effective and saved group/user IDs before executing postfilterctl.
        $) = "$group_id $group_id";
        POSIX::setgid($group_id) == 0
            or die "Unable to set gid $group_id: $!\n";
        POSIX::setuid($user_id) == 0
            or die "Unable to set uid $user_id: $!\n";

        die "Unable to drop privileges to $option{user}:$option{group}\n"
            unless $< == $user_id
                && $> == $user_id
                && $( == $group_id
                && int($)) == $group_id;

        exec { $command[0] } @command;
        die "Unable to execute $command[0] as $option{user}: $!\n";
    }

    waitpid($pid, 0);
    return 0 if $? == -1;
    return 0 if $? & 127;
    return (($? >> 8) == 0) ? 1 : 0;
}

