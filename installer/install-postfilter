# Function: _uninstall
# Purpose: Removes code and symlinks while preserving SQLite state and saved articles by default.
# Parameters: No positional parameters, or arguments are read directly by the command wrapper.
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _uninstall {
    my $candidate = "$option{filter_dir}/filter_nnrpd.pl.ng";
    my $active = "$option{filter_dir}/filter_nnrpd.pl";

    my $active_metadata = parse_hook_wrapper($active);
    if ($active_metadata) {
        my $managed = safe_release_directory(
            $option{prefix}, $active_metadata->{release_dir},
        );
        die "Uninstall refused: active filter_nnrpd.pl still uses Postfilter-NG under $option{prefix}.
"
            . "Roll back to another hook or remove it explicitly before uninstalling code.
"
            if $managed;
    }
    elsif (-l $active) {
        my $target = abs_path($active) // '';
        my $prefix = abs_path($option{prefix}) // File::Spec->rel2abs($option{prefix});
        die "Uninstall refused: active hook resolves inside $option{prefix}.
"
            if $target eq $prefix || index($target, "$prefix/") == 0;
    }

    _execute(sub {
        unlink $candidate if -e $candidate || -l $candidate;
        if (-l $option{ctl_bin}) {
            my $target = readlink($option{ctl_bin}) // '';
            unlink $option{ctl_bin}
                if index($target, $option{prefix}) == 0;
        }
        remove_tree($option{prefix}) if -d $option{prefix};
        if (-d $option{config_dir} && !$option{keep_config}) {
            remove_tree($option{config_dir});
        }
    });

    print "Uninstalled Postfilter-NG code and installer-managed candidate files.
";
    print "SQLite state and saved articles were intentionally preserved.
";
    return;
}

# Function: _print_plan
# Purpose: Displays all resolved installation paths and whether actions will be applied.
# Parameters: No positional parameters, or arguments are read directly by the command wrapper.
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _print_plan {
    print "Postfilter-NG installation plan\n";
    printf "  %-13s %s\n", 'release', $release_version;
    my $operation = $option{activate_candidate} ? 'ACTIVATE'
        : $option{rollback} ? 'ROLLBACK'
        : $option{cleanup} ? 'CLEANUP'
        : 'INSTALL-CANDIDATE';
    printf "  %-13s %s\n", 'operation', $operation;
    for my $key (qw(
        prefix filter_dir config_dir state_dir saved_dir html_dir active_file
        sendmail ctl_bin user group
    )) {
        printf "  %-13s %s\n", $key, $option{$key} // '';
    }
    printf "  %-13s %s\n",
        "hook_candidate",
        "$option{filter_dir}/filter_nnrpd.pl.ng";
    printf "  %-13s %s\n",
        "active_hook",
        "$option{filter_dir}/filter_nnrpd.pl";
    printf "  %-13s %s\n", 'perl', $perl_path;
    printf "  %-13s %s\n",
        'runtime_config',
        "$option{config_dir}/postfilter.toml";
    printf "  %-13s %s\n", 'runtime_state', $option{state_dir};
    printf "  %-13s %s\n", 'keep_releases', $option{keep_releases};
    print '  mode          '
        . ($option{dry_run} ? 'DRY-RUN' : 'APPLY')
        . "\n";
    return;
}

# Function: _usage
# Purpose: Prints command syntax and exits with the supplied status.
# Parameters: $exit_code
# Operational notes: Installer errors are fatal to the current phase and trigger code-prefix
#                    rollback where applicable.
sub _usage {
    my ($exit_code) = @_;

    print <<'USAGE';
install-postfilter [options]

Discovery:
  --use-innconfval / --no-use-innconfval
  --innconfval PATH

Paths:
  --filter-dir DIR --config-dir DIR --state-dir DIR --saved-dir DIR
  --html-dir DIR --prefix DIR --active-file FILE --sendmail FILE
  --ctl-bin FILE

Identity and operation:
  --user USER --group GROUP
  --dry-run --upgrade --force --force-config
  --activate-candidate --rollback --cleanup
  --keep-releases N          retain active plus rollback releases (minimum 2)
  --uninstall --keep-config --skip-dependency-check --help

The repository may be uploaded through GitHub Web without executable modes.
Invoke the source installer explicitly with:

  perl installer/install-postfilter [options]
USAGE

    exit $exit_code;
}

1;
